# Day Trader Telegram Bot Environment Configuration
# Copy this file to .env and fill in your values.

# 1. Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=9004936874:AAEye6CJhKQesprc5RbGvVLHzhfXZM_ocnw

# 2. Authorized Telegram User IDs (Comma-separated integers, e.g. 123456789,987654321)
# Use @userinfobot on Telegram to find your User ID.
AUTHORIZED_TELEGRAM_USER_IDS=7165581725

# 3. Alpaca Paper Trading Credentials (Get these from alpaca.markets dashboard -> Paper Trading)
ALPACA_API_KEY=PK2MF4R3HDDHPS6GRSFA4NZ4VM
ALPACA_SECRET_KEY=HvTmMWTXpzjEijhwE7n9bRwKn5a36JYYJf3L5yFivJm
# MUST be the paper-trading endpoint. Live endpoints are strictly blocked!
ALPACA_BASE_URL=https://paper-api.alpaca.markets
PAPER_TRADING_ONLY=true

# 4. Database & Logging
DATABASE_URL=sqlite+aiosqlite:///trader.db
LOG_LEVEL=INFO

# 5. SEC EDGAR User Agent (Required by SEC: Format "YourName your_email@domain.com")
SEC_USER_AGENT=DayTraderTelegramBot trader@example.com

# 6. Risk and Budget Defaults (USD)
DEFAULT_BUDGET=5000.0
DEFAULT_CASH_BUFFER_PCT=10.0
DEFAULT_MAX_POSITION_PCT=75.0
DEFAULT_MAX_ORDER_USD=4000.0
DEFAULT_MIN_ORDER_USD=5.0
DEFAULT_MAX_LOSS_PER_TRADE_USD=50.0
DEFAULT_MAX_DAILY_LOSS_USD=150.0
DEFAULT_MAX_TRADES_PER_DAY=3
DEFAULT_MAX_ORDERS_PER_DAY=10
DEFAULT_MIN_REWARD_RISK=1.0
DEFAULT_REQUIRE_STOP=true

# 7. Market Hours & Time Restrictions (New York Eastern Time)
NO_ENTRIES_BEFORE=09:45
NO_ENTRIES_AFTER=15:30
FLAT_BY=15:55
PDT_GUARD=false

# 8. Watchlist
DEFAULT_WATCHLIST=TSLA,NVDA,AAPL,MSFT,AMZN

# 9. Timeouts & Intervals
ORDER_APPROVAL_TIMEOUT_SECONDS=300
SCAN_INTERVAL_MINUTES=15
ALERT_CHECK_INTERVAL_SECONDS=60
NEWS_CHECK_INTERVAL_MINUTES=30
